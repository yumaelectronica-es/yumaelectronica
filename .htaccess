# Block direct access to Apache auth files
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>

# Protect the admin panel with HTTP Basic Auth
<Files "gestion-b3699102c9da.html">
    AuthType Basic
    AuthName "Acceso restringido"
    AuthUserFile /home/u576655189/domains/yumaelectronica.es/public_html/.htpasswd
    Require valid-user
</Files>
